{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "target": "ESNext",
    "moduleResolution": "NodeNext",

    "types": ["node", "jest"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "sourceMap": false,
    "declaration": false,

    "strict": true,

    "isolatedModules": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}